# Supabase (Project Settings → API). Without these the site still works; forms then
# hand the request to SMS/phone instead of saving it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public, browser-safe FLAME Ads delivery endpoint. Use the preview API during QA.
NEXT_PUBLIC_FLAME_ADS_API_URL=https://api.ads.flameph.org
# Initial rollout is opt-in. This is the instant publisher-side kill switch.
NEXT_PUBLIC_FLAME_ADS_ENABLED=false
